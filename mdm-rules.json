{
  "version": "1",
  "mdmTypes": ["Patient"],

  "candidateSearchParams": [
    {
      "resourceType": "Patient",
      "searchParams": ["identifier"]
    },
    {
      "resourceType": "Patient",
      "searchParams": ["family", "birthdate"]
    },
    {
      "resourceType": "Patient",
      "searchParams": ["given", "family", "birthdate"]
    }
  ],

  "candidateFilterSearchParams": [],

  "matchFields": [
    {
      "name": "philhealth-id",
      "resourceType": "Patient",
      "resourcePath": "identifier",
      "matcher": {
        "algorithm": "IDENTIFIER",
        "identifierSystem": "https://philhealth.gov.ph"
      }
    },
    {
      "name": "national-id",
      "resourceType": "Patient",
      "resourcePath": "identifier",
      "matcher": {
        "algorithm": "IDENTIFIER",
        "identifierSystem": "https://psa.gov.ph/philid"
      }
    },
    {
      "name": "facility-mrn",
      "resourceType": "Patient",
      "resourcePath": "identifier",
      "matcher": {
        "algorithm": "IDENTIFIER",
        "identifierSystem": "http://hospital.smarthealth.org/mrn"
      }
    },
    {
      "name": "family-name",
      "resourceType": "Patient",
      "resourcePath": "name.family",
      "matcher": {
        "algorithm": "STRING"
      }
    },
    {
      "name": "given-name",
      "resourceType": "Patient",
      "resourcePath": "name.given",
      "matcher": {
        "algorithm": "STRING"
      }
    },
    {
      "name": "birthdate",
      "resourceType": "Patient",
      "resourcePath": "birthDate",
      "matcher": {
        "algorithm": "DATE"
      }
    },
    {
      "name": "sex",
      "resourceType": "Patient",
      "resourcePath": "gender",
      "matcher": {
        "algorithm": "STRING",
        "exact": true
      }
    }
  ],

  "matchResultMap": {
    "philhealth-id": "MATCH",
    "national-id": "MATCH",
    "facility-mrn": "MATCH",

    "given-name,family-name,birthdate,sex": "MATCH",
    "family-name,given-name,birthdate,sex": "MATCH",

    "given-name,family-name,birthdate": "POSSIBLE_MATCH",
    "family-name,given-name,birthdate": "POSSIBLE_MATCH",
    "family-name,birthdate": "POSSIBLE_MATCH",

    "family-name": "NO_MATCH",
    "given-name": "NO_MATCH"
  },

  "eidSystems": {
    "Patient": "https://philhealth.gov.ph"
  }
}